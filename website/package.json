{
  "name": "healthaali-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official HealThaali website — personalized healthy-eating and nutrition companion (Astro, static-first).",
  "scripts": {
    "dev": "astro dev",
    "dev:force": "astro dev --force",
    "dev:stop": "astro dev stop",
    "preview:stop": "astro preview stop",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-links.mjs --external",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:recipes": "node scripts/sync-recipes.mjs --check",
    "check:launch": "node scripts/check-launch.mjs",
    "check:weight": "node scripts/check-weight.mjs",
    "check:blog-links": "node scripts/check-blog-links.mjs",
    "check:blog-dates": "node scripts/check-blog-dates.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "report:gaps": "node scripts/report-gaps.mjs",
    "reminders": "node scripts/editorial-reminders.mjs",
    "backup": "node scripts/backup.mjs",
    "mirror": "node scripts/mirror.mjs",
    "test:launch": "node --test \"scripts/**/*.test.mjs\"",
    "verify": "npm run check:recipes && npm run check:blog-links && npm run check:blog-dates && npm run build && npm run check:placeholders && npm run check:links && npm run check:weight && npm run check:seo && npm run check:a11y && npm run test:launch",
    "assets": "node scripts/extract-assets.mjs",
    "blog:images": "node scripts/blog-images.mjs",
    "recipes": "node scripts/sync-recipes.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
