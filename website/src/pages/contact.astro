---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import JsonLd from "../components/JsonLd.astro";
import SectionHeading from "../components/SectionHeading.astro";

import { organizationId } from "../data/schema";
import { contactEmail, contactEndpoint, site, siteUrl } from "../data/site";

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Contact", item: `${siteUrl}/contact` },
  ],
};

/*
  The page's subject is the organisation itself. `BaseLayout` already emits the
  site-wide Organization — logo, inbox and social profiles — as a node with an
  `@id`, so this references that node rather than declaring a second, competing
  copy. `email` is the one contact detail there is: no phone number and no
  postal address have been supplied, so neither is claimed here or anywhere else.
*/
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  url: `${siteUrl}/contact`,
  inLanguage: "en",
  mainEntity: { "@id": organizationId },
};

const formIsLive = contactEndpoint.length > 0;

const socialIcons: Record<string, string> = {
  youtube:
    '<path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.84-.43A2.5 2.5 0 0 0 21.6 16.8 26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8Z"/><path d="M10 15.1V8.9l5.2 3.1Z"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5.2"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/>',
};
---

<BaseLayout
  title="Contact HealThaali"
  description={`Reach the ${site.name} team by email at ${contactEmail}, or on our verified YouTube and Instagram channels. The message form is switched off until a backend is connected.`}
>
  <Fragment slot="head">
    <JsonLd data={breadcrumbs} />
    <JsonLd data={contactSchema} />
  </Fragment>

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">
        <span class="eyebrow__dot" aria-hidden="true"></span>
        Contact
      </p>
      <h1 class="page-hero__title">Talk to us</h1>
      <p class="page-hero__lead">
        Email reaches the inbox we actually read. Questions about a recipe, something not working,
        a topic you want us to write about — it all lands in the same place, and social messages
        usually get an answer too.
      </p>

      <div class="page-hero__actions">
        <Button href={`mailto:${contactEmail}`} icon="mail">Email {contactEmail}</Button>
        <Button href="/blog" variant="secondary" icon="arrowRight" iconPosition="end">
          Suggest a blog topic
        </Button>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="contact-channels">
    <div class="container">
      <SectionHeading
        eyebrow="Where to find us"
        eyebrowIcon="users"
        title="Two ways to reach a person"
        lead="Only channels that actually exist are listed here. There is no phone line and no postal address to publish."
        id="contact-channels"
      />

      <ul class="social-cards mt-2xl" role="list">
        <li>
          <a class="social-card" href={`mailto:${contactEmail}`}>
            <span class="social-card__icon">
              <Icon name="mail" size={20} />
            </span>
            <span>
              <span class="social-card__label">Email</span>
              <span class="social-card__value">{contactEmail}</span>
            </span>
          </a>
        </li>

        {
          site.socials.map((social) => (
            <li>
              <a class="social-card" href={social.href} target="_blank" rel="noopener noreferrer">
                <span class="social-card__icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={socialIcons[social.icon]}
                  />
                </span>
                <span>
                  <span class="social-card__label">{social.name}</span>
                  <span class="social-card__value">@healthaali · opens in a new tab</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-form">
    <div class="container split">
      <div>
        <SectionHeading
          eyebrow="Message form"
          eyebrowIcon="list"
          title={formIsLive ? "Send us a message" : "The form is switched off for now"}
          lead={formIsLive
            ? "Tell us what happened or what you need, and we will get back to you."
            : "This build has no message backend, so the form is disabled rather than pretending to send. Email reaches the same inbox and is the reliable option today."}
          id="contact-form"
        />

        {
          !formIsLive && (
            <div class="callout mt-xl">
              <Icon name="mail" size={20} />
              <span>
                <span class="callout__title">Use email instead</span>
                Write to <a href={`mailto:${contactEmail}`}>{contactEmail}</a>. When the form is
                connected it will post to the same inbox, so nothing gets lost in the meantime.
              </span>
            </div>
          )
        }

        <div class="callout callout--info mt-lg">
          <Icon name="shield" size={20} />
          <span>
            <span class="callout__title">Please do not send health details</span>
            Do not include medical information, reports or prescriptions in a message. {site.name} is
            not a medical service and cannot give individual clinical advice.
          </span>
        </div>
      </div>

      <div class="split__media">
        {
          formIsLive ? (
            <form class="card form" method="POST" action={contactEndpoint}>
              <div class="form__row">
                <div class="field">
                  <label class="field__label" for="contact-name">Name</label>
                  <input class="field__input" id="contact-name" name="name" type="text" autocomplete="name" required />
                </div>
                <div class="field">
                  <label class="field__label" for="contact-email">Email</label>
                  <input class="field__input" id="contact-email" name="email" type="email" autocomplete="email" required />
                </div>
              </div>

              <div class="field">
                <label class="field__label" for="contact-topic">What is this about?</label>
                <select class="field__select" id="contact-topic" name="topic">
                  <option value="app">The HealThaali app</option>
                  <option value="recipe">A recipe or video</option>
                  <option value="blog">A blog post</option>
                  <option value="privacy">Privacy or my data</option>
                  <option value="other">Something else</option>
                </select>
              </div>

              <div class="field">
                <label class="field__label" for="contact-message">Message</label>
                <textarea
                  class="field__textarea"
                  id="contact-message"
                  name="message"
                  required
                  placeholder="How can we help?"
                ></textarea>
                <p class="field__hint">Please do not include medical or health details.</p>
              </div>

              <Button type="submit" size="lg" icon="arrowRight" iconPosition="end">
                Send message
              </Button>
            </form>
          ) : (
            <form class="card form" aria-describedby="contact-form-inactive" novalidate>
              <div class="form__row">
                <div class="field">
                  <label class="field__label" for="contact-name">Name</label>
                  <input class="field__input" id="contact-name" name="name" type="text" disabled placeholder="Not active yet" />
                </div>
                <div class="field">
                  <label class="field__label" for="contact-email">Email</label>
                  <input class="field__input" id="contact-email" name="email" type="email" disabled placeholder="Not active yet" />
                </div>
              </div>

              <div class="field">
                <label class="field__label" for="contact-message">Message</label>
                <textarea class="field__textarea" id="contact-message" name="message" disabled placeholder="This form is not connected to a backend in this build."></textarea>
              </div>

              <Button type="button" size="lg" disabled icon="arrowRight" iconPosition="end">
                Send message
              </Button>

              <p class="notice" id="contact-form-inactive">
                Disabled on purpose: no submission endpoint is configured, so nothing typed here
                would be delivered. Email <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
                instead.
              </p>
            </form>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
