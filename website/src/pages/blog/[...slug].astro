---
import { Image } from "astro:assets";
import { render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import JsonLd from "../../components/JsonLd.astro";
import PostByline from "../../components/PostByline.astro";
import PostCard from "../../components/PostCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";

import {
  blogFeedPath,
  blogId,
  blogPath,
  formatPostDate,
  getPosts,
  postDateAttribute,
  relatedPosts,
  tagHref,
  type BlogPost,
} from "../../data/blog";
import { authorPath, authorSchemaNode } from "../../data/authors";
import { medicalDisclaimer } from "../../data/features";
import { recipes } from "../../data/recipes";
import { organizationId } from "../../data/schema";
import { absoluteUrl, site } from "../../data/site";
import { breadcrumbSchema, type Crumb } from "../../lib/breadcrumbs";

/**
 * The channel's own snapshot, keyed by video id.
 *
 * A post that embeds one of our recipes gets the real upload date, thumbnail
 * and description in its structured data instead of a VideoObject with only a
 * name — the same facts the recipes page already publishes, from the one place
 * they are stored. A video that is not in the snapshot simply gets fewer
 * fields; nothing is guessed.
 */
const recipeById = new Map(recipes.map((recipe) => [recipe.id, recipe]));

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      // Posts are sorted newest first, so index - 1 is the more recent one.
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
      // Ranked by shared tags. Empty when this post has nothing in common with
      // any other, in which case the section is not rendered at all.
      related: relatedPosts(post, posts),
    },
  }));
}

interface Props {
  post: BlogPost;
  newer: BlogPost | null;
  older: BlogPost | null;
  related: BlogPost[];
}

const { post, newer, older, related } = Astro.props;
const { Content } = await render(post.entry);

const url = absoluteUrl(post.href);

/* The visible trail and the BreadcrumbList are both built from this array. */
const crumbs: Crumb[] = [
  { name: "Home", href: "/" },
  { name: "Blog", href: blogPath },
  { name: post.title, href: post.href },
];
const breadcrumbs = breadcrumbSchema(crumbs);

/*
  One VideoObject per embed, taken from the embeds that are actually in the
  body (see `parseVideos` in src/data/blog.ts) rather than from a second list in
  frontmatter that could drift out of step with the page.
*/
const videoNodes = post.videos.map((video) => {
  const recipe = recipeById.get(video.id);

  return {
    "@type": "VideoObject",
    name: video.title,
    url: video.watchUrl,
    embedUrl: video.embedUrl,
    contentUrl: video.watchUrl,
    inLanguage: "en",
    ...(recipe
      ? {
          description: recipe.description,
          uploadDate: recipe.published,
          thumbnailUrl: absoluteUrl(recipe.image.src),
        }
      : {}),
    publisher: { "@id": organizationId },
  };
});

/*
  BlogPosting, built only from fields that actually exist. The author comes from
  src/data/authors.ts — the team today, a named person when one is added there —
  and `publisher` and `isPartOf` reference the site-wide Organization and the
  blog index's Blog node by `@id` rather than restating them. `dateModified`
  falls back to the publication date, which is true.
*/
const postSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  url,
  mainEntityOfPage: url,
  datePublished: post.publishedAt.toISOString(),
  dateModified: (post.updatedAt ?? post.publishedAt).toISOString(),
  inLanguage: "en",
  wordCount: post.wordCount,
  author: authorSchemaNode(post.author),
  publisher: { "@id": organizationId },
  isPartOf: { "@id": blogId },
  ...(post.tags.length > 0
    ? { articleSection: post.tags[0], keywords: post.tags.join(", ") }
    : {}),
  ...(post.cover && post.coverUrl
    ? {
        image: {
          "@type": "ImageObject",
          url: post.coverUrl,
          width: post.cover.width,
          height: post.cover.height,
        },
      }
    : {}),
  ...(videoNodes.length > 0 ? { video: videoNodes } : {}),
};

const wasUpdated = post.updatedAt && post.updatedAt.getTime() > post.publishedAt.getTime();
---

<BaseLayout
  title={post.title}
  description={post.description}
  image={post.coverUrl ?? "/og-image.jpg"}
  imageAlt={post.coverAlt}
  type="article"
  canonical={post.href}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href={blogFeedPath} />

    {/*
      The article's own Open Graph fields, which `og:type=article` promises.
      They are emitted here rather than in BaseLayout because only a post knows
      them — every other page on the site is a plain website.
    */}
    <meta property="article:published_time" content={post.publishedAt.toISOString()} />
    {
      post.updatedAt && (
        <meta property="article:modified_time" content={post.updatedAt.toISOString()} />
      )
    }
    <meta property="article:author" content={absoluteUrl(authorPath(post.author.id))} />
    {post.tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <JsonLd data={breadcrumbs} />
    <JsonLd data={postSchema} />
  </Fragment>

  <article>
    <section class="page-hero">
      <div class="container container--narrow">
        <Breadcrumbs crumbs={crumbs} />

        <h1 class="page-hero__title">{post.title}</h1>

        <PostByline author={post.author} />

        <p class="post-meta">
          <time datetime={postDateAttribute(post.publishedAt)}>
            {formatPostDate(post.publishedAt)}
          </time>
          <span aria-hidden="true">·</span>
          <span>{post.readingMinutes} min read</span>
        </p>

        {
          wasUpdated && post.updatedAt && (
            <p class="notice">
              Last updated <time datetime={postDateAttribute(post.updatedAt)}>
                {formatPostDate(post.updatedAt)}
              </time>.
            </p>
          )
        }

        {
          post.tags.length > 0 && (
            /*
              Here the tags are links, because this page has no card overlay
              swallowing clicks. They stay plain <span> chips inside a listing
              card on purpose: PostCard has a single link by design, and a second
              interactive element underneath its ::after overlay would be
              unreachable by keyboard and mouse alike.
            */
            <nav aria-label="Topics for this post">
              <ul class="post-tags list-reset" role="list">
                {post.tags.map((tag) => (
                  <li>
                    <a class="chip chip--brand" href={tagHref(tag)}>
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </section>

    {
      post.cover && (
        <div class="container container--narrow">
          <Image
            src={post.cover}
            alt={post.coverAlt ?? ""}
            widths={[480, 800, 1200]}
            sizes="(max-width: 767px) 92vw, 720px"
            loading="eager"
            decoding="async"
            class="post-cover"
          />
        </div>
      )
    }

    <section class="section">
      <div class="container container--narrow">
        {/* Rendered Markdown. Headings inside a post start at `##` — a `#` in a
            body is rejected at build time, since the <h1> is the title above. */}
        <div class="prose">
          <Content />
        </div>

        {/*
          The same scope statement /features and the app pages carry, in the same
          words and from the same module — a post about food is still general
          information, and this says so on the page rather than in a footer
          nobody reads.
        */}
        <p class="notice mt-xl">{medicalDisclaimer}</p>
      </div>
    </section>
  </article>

  {
    related.length > 0 && (
      <section class="section section--alt" aria-labelledby="related-title">
        <div class="container">
          <SectionHeading
            eyebrow="Keep reading"
            eyebrowIcon="list"
            title="Related posts"
            lead="Every card below shares at least one topic with this post, chosen by shared tags rather than by a guess."
            id="related-title"
          />

          <ul class="card-grid card-grid--3 mt-2xl list-reset" role="list">
            {related.map((entry) => (
              <PostCard post={entry} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/*
    Who wrote this, on the page itself rather than only in the markup. A byline
    that links to an author page with a real description is the part of
    authorship a reader (and a search engine's quality rater) can check.
  */}
  <section class="section--tight" aria-labelledby="post-author-title">
    <div class="container container--narrow">
      <h2 class="sr-only" id="post-author-title">About the author</h2>
      <PostByline author={post.author} variant="card" />
    </div>
  </section>

  <section class="section" aria-labelledby="post-nav-title">
    <div class="container container--narrow">
      <h2 class="sr-only" id="post-nav-title">More posts</h2>

      <nav class="post-nav" aria-label="Other posts">
        {
          older ? (
            <a class="post-nav__link" href={older.href}>
              <span class="post-nav__label">
                <Icon name="arrowRight" size={14} />
                Older
              </span>
              <span class="post-nav__title">{older.title}</span>
            </a>
          ) : (
            <span />
          )
        }

        {
          newer ? (
            <a class="post-nav__link post-nav__link--end" href={newer.href}>
              <span class="post-nav__label">
                Newer
                <Icon name="arrowRight" size={14} />
              </span>
              <span class="post-nav__title">{newer.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>

      <p class="mt-xl">
        <a class="link-arrow" href={blogPath}>
          <Icon name="arrowRight" size={15} />
          All posts
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
