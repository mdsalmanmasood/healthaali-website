---
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

interface Props {
  variant?: "primary" | "secondary" | "ghost" | "accent";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  block?: boolean;
  icon?: IconName;
  iconPosition?: "start" | "end";
  class?: string;
  ariaLabel?: string;
  /** Open in a new tab (adds rel="noopener noreferrer"). */
  external?: boolean;
  disabled?: boolean;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  block = false,
  icon,
  iconPosition = "start",
  class: className = "",
  ariaLabel,
  external = false,
  disabled = false,
  ...rest
} = Astro.props;

// `.btn` is only the shared shell — every button needs its variant class,
// including the primary one.
const classes = [
  "btn",
  `btn--${variant}`,
  size !== "md" && `btn--${size}`,
  block && "btn--block",
  className,
].filter(Boolean).join(" ");

const isLink = typeof href === "string" && href.length > 0;
const Tag = isLink ? "a" : "button";
---

<Tag
  class={classes}
  href={isLink ? href : undefined}
  type={isLink ? undefined : type}
  aria-label={ariaLabel}
  disabled={!isLink && disabled ? true : undefined}
  aria-disabled={isLink && disabled ? "true" : undefined}
  target={isLink && external ? "_blank" : undefined}
  rel={isLink && external ? "noopener noreferrer" : undefined}
  {...rest}
>
  {icon && iconPosition === "start" && <Icon name={icon} size={18} class="btn__icon" />}
  <span><slot /></span>
  {icon && iconPosition === "end" && <Icon name={icon} size={18} class="btn__icon" />}
</Tag>
