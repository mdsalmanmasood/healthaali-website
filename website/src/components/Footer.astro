---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { footerNav } from "../data/navigation";
import { site } from "../data/site";

const year = new Date().getFullYear();

/** Brand marks for the verified social accounts listed in src/data/site.ts. */
const socialIcons: Record<string, string> = {
  youtube:
    '<path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.84-.43A2.5 2.5 0 0 0 21.6 16.8 26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8Z"/><path d="M10 15.1V8.9l5.2 3.1Z"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5.2"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/>',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo />
        <p class="site-footer__blurb">{site.description}</p>

        {
          site.socials.length > 0 && (
            <div class="social-row mt-lg">
              {site.socials.map((social) => (
                <a
                  class="social-link"
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${site.name} on ${social.name}`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={socialIcons[social.icon]}
                  />
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        footerNav.map((group) => (
          <div>
            <h2 class="site-footer__col-title">{group.title}</h2>
            <ul class="site-footer__list">
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="site-footer__promises">
        <Icon name="leaf" size={14} />
        <span>{site.promises.join(" · ")}</span>
      </p>
    </div>
  </div>
</footer>
