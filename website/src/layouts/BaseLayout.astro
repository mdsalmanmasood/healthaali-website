---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import JsonLd from "../components/JsonLd.astro";
import { siteSchema } from "../data/schema";
import { absoluteUrl, analyticsId, buildCommit, site, siteUrl } from "../data/site";

import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/components.css";
import "../styles/utilities.css";

interface Props {
  /** Page title. The brand is appended automatically when it is missing. */
  title: string;
  description: string;
  /** Path or absolute URL to a 1200x630 social image. */
  image?: string;
  /**
   * Description of `image`, when there is something to say about it. Blog posts
   * pass their cover's alt text: a social card is read aloud by screen readers
   * like any other image, and an empty `og:image:alt` is a missed description
   * rather than a neutral choice.
   */
  imageAlt?: string;
  /**
   * Real pixel dimensions of `image`, for the `og:image:width`/`height` pair.
   *
   * These are declared to social platforms so the card can be laid out before
   * the image is fetched, which means a wrong pair is worse than none: a dish
   * page passes the dimensions of the thumbnail it actually shares, instead of
   * inheriting the 1200x630 of the site-wide card (its own is 800x450, which a
   * hardcoded pair would have misdescribed on every one of them).
   */
  imageWidth?: number;
  imageHeight?: number;
  /** `article` for blog posts and other dated writing, `website` otherwise. */
  type?: "website" | "article";
  /** Override the canonical path/URL (defaults to the current URL). */
  canonical?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  image = "/og-image.jpg",
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  type = "website",
  canonical,
  noindex = false,
  bodyClass = "",
} = Astro.props;

const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
// A noindex page has no canonical URL to claim. 404.astro is the only such page,
// and it is served for *any* unknown path, so Astro's route pathname (`/404/`)
// describes a URL this site does not actually serve. Emitting it would be an
// invented URL in the <head>, so both tags are omitted instead.
const canonicalUrl = noindex
  ? undefined
  : canonical
    ? absoluteUrl(canonical)
    : new URL(Astro.url.pathname, siteUrl).href;
const ogImage = /^https?:\/\//.test(image) ? image : absoluteUrl(image);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:image" content={ogImage} />
    {imageAlt ? <meta property="og:image:alt" content={imageAlt} /> : null}
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt ? <meta name="twitter:image:alt" content={imageAlt} /> : null}

    <!-- Icons, manifest, theme colour -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fdfbf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1511" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <!--
      Which revision this page was built from. The host supplies it
      (CF_PAGES_COMMIT_SHA on Cloudflare Pages, GITHUB_SHA in Actions) and
      `npm run check:launch` compares it against the repository's HEAD, so a
      deployment that is serving the wrong commit says so out loud.
    -->
    <meta name="build-commit" content={buildCommit} />

    <!--
      Theme boot. Runs before anything paints so dark mode never flashes white.
      Kept inline (not bundled) on purpose: it must not wait for a network round-trip.
    -->
    <script is:inline>
      (function () {
        var KEY = "healthaali-theme";
        var root = document.documentElement;
        var media = window.matchMedia("(prefers-color-scheme: dark)");

        function apply() {
          var pref = "system";
          try {
            pref = localStorage.getItem(KEY) || "system";
          } catch (e) {
            /* private mode / storage disabled: fall back to system */
          }
          var dark = pref === "dark" || (pref !== "light" && media.matches);
          root.classList.toggle("dark", dark);
          root.setAttribute("data-theme", pref);
          root.style.colorScheme = dark ? "dark" : "light";

          // Let the toggle keep its label in sync when the preference changes
          // from anywhere (click, system change, another tab).
          document.dispatchEvent(
            new CustomEvent("healthaali:themechange", { detail: { preference: pref, dark: dark } })
          );
        }

        apply();
        window.__healthaaliApplyTheme = apply;

        try {
          media.addEventListener("change", apply);
        } catch (e) {
          /* older browsers: no live system-preference updates */
        }

        // Re-apply after an Astro view-transition swap.
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>

    <ClientRouter />

    {
      analyticsId ? (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${analyticsId}"}`}
        />
      ) : null
    }

    <!--
      Site-wide structured data (Organization + WebSite). Emitted here, once,
      for every page; per-page nodes (breadcrumbs, BlogPosting, …) come through
      the `head` slot below and reference these by `@id`.
    -->
    <JsonLd data={siteSchema} />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    {/*
      Click-to-play YouTube embeds.

      A page embeds a video as a <figure class="yt-embed" data-yt="…"> — from
      the Markdown of a post, or from components/VideoEmbed.astro on a recipe
      card and a dish's own page. Until someone presses play, this page makes
      no request to any Google host: no player script, no thumbnail, no cookie.
      The button below is built here because JavaScript is what can build it —
      without it the figure's plain <a> to the same video still works, which is
      why that link is in the markup and not generated.

      The handler is registered on the button it creates, and re-runs on
      `astro:page-load` so it also applies after a client-side navigation. It is
      built from the same icon set as the rest of the site, so the glyph cannot
      drift from the play icons elsewhere.
    */}
    <script>
      // Only the play glyph, not the whole icon set: see the note in lib/icons.ts.
      import { playGlyph } from "../lib/icons";

      const FIGURE = "[data-yt]";
      const PLAY_GLYPH = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${playGlyph}</svg>`;

      /** Swap the play button for the real player, once, when it is pressed. */
      const loadPlayer = (figure: HTMLElement, player: HTMLElement) => {
        const id = figure.dataset.yt ?? "";
        const title = figure.dataset.ytTitle ?? "";
        if (!id) return;

        const iframe = document.createElement("iframe");
        iframe.className = "yt-embed__iframe";
        iframe.title = title;
        iframe.loading = "lazy";
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        // Autoplay is allowed because a press is what got here.
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;

        player.replaceChildren(iframe);
        iframe.focus();
        figure.dataset.ytLoaded = "1";
      };

      const upgrade = (figure: HTMLElement) => {
        if (figure.dataset.ytReady === "1") return;

        const title = figure.dataset.ytTitle ?? "";
        const fallback = figure.querySelector(".yt-embed__fallback");
        if (!title || !fallback) return;

        // The player keeps the descriptive title; the button may say something
        // shorter, because on a card the title is already printed underneath.
        const buttonText = figure.dataset.ytLabel || title;

        const shape = figure.dataset.ytShape === "vertical" ? "vertical" : "wide";

        const player = document.createElement("div");
        player.className = `yt-embed__player yt-embed__player--${shape}`;

        const button = document.createElement("button");
        button.type = "button";
        button.className = "yt-embed__play";

        const glyph = document.createElement("span");
        glyph.className = "yt-embed__play-icon";
        glyph.setAttribute("aria-hidden", "true");
        glyph.innerHTML = PLAY_GLYPH;

        const label = document.createElement("span");
        label.className = "yt-embed__play-label";
        // textContent, never innerHTML: this text comes from the page.
        label.textContent = buttonText;

        button.append(glyph, label);
        button.addEventListener("click", () => loadPlayer(figure, player));

        player.append(button);
        fallback.replaceWith(player);
        figure.dataset.ytReady = "1";
      };

      const upgradeAll = () =>
        document.querySelectorAll<HTMLElement>(FIGURE).forEach((figure) => {
          if (figure.dataset.ytLoaded !== "1") upgrade(figure);
        });

      upgradeAll();
      document.addEventListener("astro:page-load", upgradeAll);
    </script>
  </body>
</html>
