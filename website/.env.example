# ─────────────────────────────────────────────────────────────────────────────
# HealThaali website — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Only variables prefixed with PUBLIC_ are exposed to the browser.
# NEVER put API keys, database credentials or service-role keys here.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site origin (used as a fallback when Astro's `site` is unavailable)
PUBLIC_SITE_URL=https://healthaali.in

# The real HealThaali web application, e.g. https://app.healthaali.in
# Leave empty until the app is live — the site then shows "Coming soon"
# instead of linking to a placeholder domain.
PUBLIC_WEBAPP_URL=

# Google Play listing for the Android app.
# Leave empty until the listing exists — the site then shows "Coming soon".
PUBLIC_ANDROID_URL=

# Support / contact address. Leave empty to hide the email row on /contact.
PUBLIC_CONTACT_EMAIL=

# Contact form endpoint (Formspree, Basin, Cloudflare Worker, ...).
# Leave empty to keep the form in "not connected yet" mode.
PUBLIC_CONTACT_ENDPOINT=

# Privacy-friendly analytics id (e.g. Cloudflare Web Analytics token).
# Leave empty to ship zero analytics.
PUBLIC_ANALYTICS_ID=
